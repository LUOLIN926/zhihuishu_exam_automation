# 智慧树账号配置
ZHIHUISHU_USERNAME=YOURNAME
ZHIHUISHU_PASSWORD=YOURPASSWORD

# 视频下载器专用配置
COURSE_NAME="课程名称"
DOWNLOAD_DIR="./videos"         # 视频保存目录（相对于脚本所在目录）
QUALITY="low"                  # high=高清(原画) / low=标清(512)
CONCURRENT=3                   # 同时下载数量

# 视频转写 API 配置（用于转写生成 Markdown 知识库）
MIMO_API_KEY=YOUR_MIMO_API_KEY
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-asr

# API配置（用于考试自动答题，默认支持 DeepSeek，同时向下兼容 QWEN_API_KEY）
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"
DEEPSEEK_ENDPOINT="https://api.deepseek.com/v1"
# 若使用通义千问，可填 QWEN_API_KEY 与 QWEN_ENDPOINT="https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"

# 答题与 OCR 模型配置（默认使用 deepseek-v4-flash-vision-exp 多模态模型）
ANSWER_MODEL="deepseek-v4-flash-vision-exp"  # 用于考试答题的模型
OCR_MODEL="deepseek-v4-flash-vision-exp"     # 用于OCR识别的视觉模型

# 可选配置
SKIP_COMPLETED_QUESTIONS=true  # 是否跳过已完成的题目
ENABLE_REASONING=false         # 是否启用推理模式
EXAM_URL=""                    # 考试链接（如果有特定链接）
AUTOMODE=false                 # 是否开启全自动考试模式（自动登录并依次完成指定课程的所有未做考试）

# 参考资料配置（答题脚本使用）
REFERENCE_DIR="reference_materials"  # 参考资料文件夹路径，默认为 reference_materials
REFERENCE_MODE="rag"                 # 参考资料模式：rag (智能检索 top K)，full (全部导入)，none (不导入)
REFERENCE_TOP_K=3                    # 当模式为 rag 时，检索的相关文档数量
RAG_HIGH_MATCH_THRESHOLD=5.0        # 当 RAG 检索最大匹配得分低于该值时，强烈鼓励大模型使用联网搜索工具进行查询与比对（默认 5.0）

# V2 Memory 配置（独立新版本，不影响现有脚本默认流程）
MEMORY_ENABLED=true
MEMORY_DB_PATH="./memory/zhihuishu_memory.sqlite3"
MEMORY_REUSE_THRESHOLD=0.92
MEMORY_REFERENCE_THRESHOLD=0.70
MEMORY_SAVE_TEXT_EVIDENCE=true
MEMORY_SAVE_RAW_PROMPT=false
MEMORY_SAVE_REASONING=false
